# Ejemplo de Variables de Entorno
# Copia este archivo a .env para desarrollo local
# NUNCA comprometas el archivo .env con credenciales reales

# Configuración de Google Cloud
GCP_PROJECT_ID=proyecto-blockchain-linsi
GCP_REGION=us-central1

# Configuración de la aplicación
APP_NAME=blockchain-app
PORT=8080

# Base de datos (ejemplo para Cloud SQL)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/blockchain
# O con Cloud SQL Proxy:
# DATABASE_URL=postgresql://usuario:password@/blockchain?host=/cloudsql/proyecto:region:instancia

# Base de datos (ejemplo para Firestore)
# FIRESTORE_PROJECT_ID=proyecto-blockchain-linsi

# Configuración de producción
PYTHON_ENV=production

# Configuración de seguridad
# SECRET_KEY=tu-clave-secreta-aqui
# JWT_SECRET=tu-jwt-secret-aqui
